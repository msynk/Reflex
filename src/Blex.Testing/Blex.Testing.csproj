<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BlexTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Blex.Testing</PackageId>
    <Title>Blex.Testing</Title>
    <Description>Testing helpers for Blex: an action-recording harness and assertions for stores and the manager.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- See Blex.Blazor.csproj: keeps the bundled source generator flowing transitively. -->
    <ProjectReference Include="..\Blex\Blex.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
