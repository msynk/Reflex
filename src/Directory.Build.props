<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The frameworks every shipping library targets. Tests, benchmarks and demos pin their own. -->
  <PropertyGroup>
    <ReflexTargetFrameworks>net8.0;net9.0;net10.0</ReflexTargetFrameworks>
  </PropertyGroup>

  <!-- Package identity. Only the four library projects opt in with <IsPackable>true</IsPackable>. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.3.0</Version>
    <Authors>Saleh Yusefnejad</Authors>
    <Product>Reflex</Product>
    <Copyright>Copyright (c) 2026 Saleh Yusefnejad</Copyright>
    <PackageProjectUrl>https://github.com/msynk/Reflex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msynk/Reflex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>blazor;state-management;state;store;redux;flux;devtools;source-generator;reactive;fluxor</PackageTags>
    <PackageReleaseNotes>https://github.com/msynk/Reflex/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <!-- Symbols + Source Link, so stepping into Reflex from a consumer's debugger works. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
