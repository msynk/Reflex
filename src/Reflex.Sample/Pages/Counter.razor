@page "/counter"
@inherits ReflexComponentBase
@inject CounterStore Store

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p>
    Reactive state, a memoized computed value, and named actions &mdash; all generated from a few
    annotated fields. Open the Redux DevTools panel and watch the actions stream in, then drag the
    slider to time-travel.
</p>

<div class="card p-3 mb-3" style="max-width: 28rem;">
    <p role="status" class="fs-4">Count: <strong>@Store.Count</strong></p>
    <ul>
        <li>DoubleCount (computed): <strong>@Store.DoubleCount</strong></li>
        <li>IsEven (computed): <strong>@Store.IsEven</strong></li>
        <li>Step: <strong>@Store.Step</strong></li>
    </ul>

    <div class="btn-group mb-2" role="group">
        <button class="btn btn-primary" @onclick="Store.Increment">+ @Store.Step</button>
        <button class="btn btn-outline-primary" @onclick="Store.Decrement">- @Store.Step</button>
        <button class="btn btn-outline-secondary" @onclick="Store.Reset">Reset</button>
    </div>

    <div class="d-flex align-items-center gap-2">
        <label class="form-label m-0">Step</label>
        <button class="btn btn-sm btn-light" @onclick="() => Store.SetStep(1)">1</button>
        <button class="btn btn-sm btn-light" @onclick="() => Store.SetStep(5)">5</button>
        <button class="btn btn-sm btn-light" @onclick="() => Store.SetStep(10)">10</button>
    </div>
</div>

@code {
    protected override void OnInitialized() => Subscribe(Store);
}
