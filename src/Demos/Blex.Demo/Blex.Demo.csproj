<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- A docs app is not a library; every public type here is demo material. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Trim the published payload: the docs site ships as static files. -->
    <BlazorEnableCompression>true</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Reflex\Reflex.csproj" />
    <ProjectReference Include="..\..\Reflex.Blazor\Reflex.Blazor.csproj" />
    <ProjectReference Include="..\..\Reflex.Generators\Reflex.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
