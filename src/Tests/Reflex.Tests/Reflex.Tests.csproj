<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs against every framework the packages ship for, so no TFM leg goes untested. -->
    <TargetFrameworks>$(ReflexTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- REFLEX011 is intentionally triggered by a fixture that verifies value-returning actions. -->
    <NoWarn>$(NoWarn);REFLEX011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Reflex\Reflex.csproj" />
    <ProjectReference Include="..\..\Reflex.Testing\Reflex.Testing.csproj" />
    <ProjectReference Include="..\..\Reflex.Generators\Reflex.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
