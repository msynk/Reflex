<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>$(BlexTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Blex.Blazor</PackageId>
    <Title>Blex.Blazor</Title>
    <Description>Blazor integration for Blex: the BlexComponentBase base class, &lt;BlexProvider&gt;, browser-storage persistence, and the Redux DevTools time-travel bridge.</Description>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
    <ComponentsWebVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.11</ComponentsWebVersion>
    <ComponentsWebVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.0</ComponentsWebVersion>
    <ComponentsWebVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.0</ComponentsWebVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(ComponentsWebVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PrivateAssets="none" keeps NuGet from stamping exclude="Build,Analyzers" on the Blex
      dependency, so the bundled source generator still reaches a project that references only
      Blex.Blazor. Without it those consumers get the runtime but no codegen.
    -->
    <ProjectReference Include="..\Blex\Blex.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
